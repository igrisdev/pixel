generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum SystemRole {
  ADMIN
  MEMBER
}

enum AcademicStatus {
  STUDENT
  GRADUATE
}

enum ApprovalStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum CategoryType {
  DEVELOPMENT
  EVENT
  WRITING
}

// Nivel de acceso de un integrante sobre un proyecto macro.
enum ProjectAccess {
  LEADER       // Puede editar el proyecto y gestionar su equipo
  COLLABORATOR // Solo puede aportar productos
}

enum CompetencyType {
  TECHNICAL
  SOFT
}

// --- MODELOS ---

model Member {
  id                  Int       @id @default(autoincrement())
  fullName            String
  institutionalEmail  String    @unique
  personalEmail       String?
  passwordHash        String
  professionalProfile String?   @db.Text
  career              String
  role                String
  systemRole          SystemRole @default(MEMBER)
  academicStatus      AcademicStatus @default(STUDENT)
  photoUrl            String?
  isBanned            Boolean   @default(false)
  cvUrl               String?

  // Relaciones
  links               ProfessionalLink[]
  participations      Participation[]
  projectsCreated     Project[]          @relation("ProjectCreator")
  projectMemberships  ProjectMember[]

  // Relación Muchos a Muchos implícita con Competency
  competencies        Competency[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ProfessionalLink {
  id        Int    @id @default(autoincrement())
  memberId  Int
  platform  String
  url       String

  // Relaciones
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Competency {
  id          Int            @id @default(autoincrement())
  name        String
  description String         @db.Text
  type        CompetencyType

  // Relación Muchos a Muchos implícita con Member
  members     Member[]
}

model Project {
  id             Int            @id @default(autoincrement())
  title          String
  objective      String         @db.Text
  awards         String?        @db.Text
  startDate      DateTime
  endDate        DateTime?
  coverImageUrl  String?
  approvalStatus ApprovalStatus @default(PENDING)
  createdBy      Int

  // Relaciones
  creator        Member         @relation("ProjectCreator", fields: [createdBy], references: [id])
  products       AcademicProduct[]
  members        ProjectMember[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// Equipo del proyecto macro. Independiente de las participaciones en
// productos: define quién puede trabajar sobre el proyecto y con qué permisos.
model ProjectMember {
  id        Int           @id @default(autoincrement())
  projectId Int
  memberId  Int
  access    ProjectAccess @default(COLLABORATOR)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, memberId])
}

model AcademicProduct {
  id                Int            @id @default(autoincrement())
  projectId         Int
  title             String
  description       String         @db.Text
  categoryType      CategoryType
  approvalStatus    ApprovalStatus @default(PENDING)
  createdBy         Int?           // Miembro que creó el producto (null para productos legados/admin)
  
  technologies      Json?

  // Galería del producto: array de URLs de imágenes (máximo 10).
  images            Json?

  repositoryUrl     String?
  demoUrl           String?
  publicationSource String?
  documentUrl       String?

  // Contexto opcional, disponible para cualquier categoría de producto.
  city              String?   // Ciudad
  eventName         String?   // Nombre del evento
  venue             String?   // Lugar del evento (universidad, auditorio, etc.)
  startDate         DateTime? // Fecha de inicio
  endDate           DateTime? // Fecha de fin

  // Relaciones
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participations    Participation[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Participation {
  id             Int       @id @default(autoincrement())
  memberId       Int
  productId      Int
  productRole    String
  startDate      DateTime
  endDate        DateTime?

  // Relaciones
  member         Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  product        AcademicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Limitador de tasa persistente (ventana fija). Una fila por clave (p. ej.
// "login:<ip>:<email>") con su contador y el instante de reinicio.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
}
